{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/davet/:kod", "destination": "/davet/index.html" },
    { "source": "/davet/:kod/", "destination": "/davet/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
