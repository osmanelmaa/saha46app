{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/davet/:kod", "destination": "/davet/" },
    { "source": "/davet/:kod/", "destination": "/davet/" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
